#It gives "True" if it is a leap year and "False" if it is not a leap year
def is_leap_year(y):
  if y%4 == 0:
    if y%100 == 0:
      if y%400 == 0:
        print("Leap year")
      else:
        print("Not a leap year")
    else:
      print("Leap Year")
  else:
    print("Not a leap year")


